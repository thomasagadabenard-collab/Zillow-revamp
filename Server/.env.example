# Copy to .env, keep your existing Neon DATABASE_URL, and never commit real credentials.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Replace this example with your existing Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=0

# Set this to the administrator account that you create using db:seed-admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NOTIFICATION_EMAIL=

# SMTP is optional for sign-in, but required for admin email notifications and password resets.
# For Gmail, use an App Password (not your normal Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# NOWPayments API credentials. Register the IPN secret in NOWPayments Payment Settings.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
NOWPAYMENTS_PRICE_CURRENCY=usd
NOWPAYMENTS_PAY_CURRENCY=btc
# Replace with your deployed public HTTPS API URL before production checkout.
NOWPAYMENTS_IPN_URL=https://api.yourdomain.com/api/payments/nowpayments/ipn

# Uploads live under this folder; use persistent storage on the production host.
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=1572864
MAX_MEDIA_BYTES=52428800
MAX_MEDIA_FILES=8
